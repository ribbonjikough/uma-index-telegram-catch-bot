# Token from @BotFather (required)
TELEGRAM_BOT_TOKEN= your_telegram_bot_token_here

# Optional: always post to this chat or channel ID (leave empty to post only to subscribers)
TELEGRAM_CHAT_ID=

# Oldest page in the scan window (default 1)
MIN_PAGES=1

# Newest page in the scan window (default 3 pages)
MAX_PAGES=3
